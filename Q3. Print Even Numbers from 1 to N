import java.util.Scanner;

public class Main {
    static void printEven(int i, int n) {
        if (i > n) return;
        System.out.print(i + " ");
        printEven(i + 2, n);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        printEven(2, n);
    }
}
