
import java.util.Scanner;

public class Main {
    static int minimum(int[] a, int index) {
        if (index == a.length - 1) {
            return a[index];
        }

        int min = minimum(a, index + 1);

        return Math.min(a[index], min);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        System.out.print(minimum(a, 0));
    }
}
