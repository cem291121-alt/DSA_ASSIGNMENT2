
import java.util.Scanner;

public class Main {
    static int search(int[] a, int index, int x) {
        if (index == a.length) {
            return -1;
        }

        if (a[index] == x) {
            return index;
        }

        return search(a, index + 1, x);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int x = sc.nextInt();
        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        System.out.print(search(a, 0, x));
    }
}
